{
  "name": "pele-animate",
  "version": "0.12.0",
  "description": "Animated, illustrated SVG scenes from plain Mermaid code, as a post-processor for Pele.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/dkdev24/pele-animate#readme",
  "publishConfig": { "access": "public" },
  "author": "Daniel Kim",
  "repository": { "type": "git", "url": "git+https://github.com/dkdev24/pele-animate.git" },
  "keywords": ["mermaid", "pele", "svg", "diagram", "animation"],
  "exports": {
    ".": "./pele-animate.js",
    "./glyphs": "./glyphs.js",
    "./preset-doverunner": "./preset-doverunner.js",
    "./style.css": "./pele-animate.css"
  },
  "files": ["pele-animate.js", "pele-animate.css", "glyphs.js", "preset-doverunner.js", "README.md", "LICENSE"],
  "sideEffects": ["*.css", "./preset-doverunner.js"],
  "peerDependencies": { "pele": "^1.7.0" },
  "devDependencies": { "pele": "^1.7.0" }
