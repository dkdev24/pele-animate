{
  "name": "pele-animate",
  "version": "0.16.0",
  "description": "Step-by-step animated Mermaid diagrams with icons: an unofficial add-on for the Pele renderer.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/dkdev24/pele-animate#readme",
  "packageManager": "pnpm@10.13.1",
  "scripts": { "test": "node scripts/check-docs.mjs", "build": "pnpm -r --filter ./site build" },
  "publishConfig": { "access": "public" },
  "author": "Daniel Kim",
  "repository": { "type": "git", "url": "git+https://github.com/dkdev24/pele-animate.git" },
  "keywords": ["mermaid", "pele", "svg", "diagram", "animation"],
  "types": "./types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./pele-animate.js" },
    "./glyphs": { "types": "./types/glyphs.d.ts", "default": "./glyphs.js" },
    "./preset-doverunner": { "types": "./types/preset-doverunner.d.ts", "default": "./preset-doverunner.js" },
    "./style.css": "./pele-animate.css",
    "./tabler/*": { "types": "./types/tabler-pack.d.ts", "default": "./tabler/*.js" }
  },
  "files": ["pele-animate.js", "pele-animate.css", "glyphs.js", "preset-doverunner.js", "tabler", "types", "docs", "skills", "THIRD-PARTY-NOTICES.md", "README.md", "LICENSE"],
  "sideEffects": ["*.css", "./preset-doverunner.js", "./tabler/*.js"],
  "peerDependencies": { "pele": "^1.7.0" },
  "devDependencies": { "pele": "^1.7.0" }
}
